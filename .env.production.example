# Copy to .env.production on the target server. Do not commit the copied file.
# Replace SERVER_ADDRESS with the server IP or public hostname when available.
PUBLIC_UI_URL=http://SERVER_ADDRESS:4000
PUBLIC_REST_URL=http://SERVER_ADDRESS:8501/server
DSPACE_REST_HOST=SERVER_ADDRESS
DSPACE_REST_SSL=false
DSPACE_REST_PORT=8501
POSTGRES_PASSWORD=CHANGE_THIS_TO_A_LONG_RANDOM_VALUE
TRUSTED_PROXY_NETWORK=10.250.50
UI_BIND_PORT=4000
REST_BIND_PORT=8501
