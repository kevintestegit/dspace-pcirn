# Modelo do .env de producao. Copie para .env.production no servidor e preencha:
#   cp .env.production.example .env.production && chmod 600 .env.production
# O arquivo copiado nao deve ser versionado nem compartilhado.
#
# Uso:
#   docker compose -f docker-compose.yml --env-file .env.production up -d

# --- PostgreSQL administrado pelo NTI -------------------------------------
# Obrigatorios. O stack nao sobe sem eles.
# DB_URL e a URL JDBC completa; o banco nao roda em container nesta stack.
# Para exigir TLS parametros do driver podem ser anexados, por exemplo:
#   jdbc:postgresql://HOST:5432/dspace?sslmode=require
DB_URL=jdbc:postgresql://HOST:5432/dspace
DB_USERNAME=dspace
DB_PASSWORD=CHANGE_THIS_TO_A_LONG_RANDOM_VALUE

# --- URLs publicas (servidas pelo proxy TLS) -------------------------------
# Devem usar https:// ou o backend recusa iniciar.
PUBLIC_UI_URL=https://REPLACE_WITH_PUBLIC_HOSTNAME
PUBLIC_REST_URL=https://REPLACE_WITH_PUBLIC_HOSTNAME/server
# Host usado pelo servidor de SSR para montar as chamadas ao REST.
PUBLIC_REST_HOST=REPLACE_WITH_PUBLIC_HOSTNAME

# --- Imagens versionadas ---------------------------------------------------
# Nunca use "latest". Fixe a versao que sera publicada para o servidor.
DSPACE_IMAGE=CHANGE_THIS_TO_THE_VERSIONED_BACKEND_IMAGE
SOLR_IMAGE=CHANGE_THIS_TO_THE_VERSIONED_SOLR_IMAGE
ANGULAR_IMAGE=CHANGE_THIS_TO_THE_VERSIONED_ANGULAR_IMAGE

# --- Armazenamento persistente --------------------------------------------
# Caminho no servidor onde ficam os bitstreams. Precisa sobreviver a
# atualizacao de imagens e ser incluido no backup.
ASSETSTORE_PATH=/srv/dspace/assetstore

# --- Rede e portas ---------------------------------------------------------
# Faixa do proxy reverso que o REST deve confiar ao ler X-Forwarded-*.
# Precisa ser coerente com DSPACE_NETWORK_SUBNET abaixo.
TRUSTED_PROXY_NETWORK=10.250.50
DSPACE_NETWORK_SUBNET=10.250.50.0/24

# Portas ligadas apenas a 127.0.0.1; o proxy expoe o servico.
UI_BIND_PORT=4000
REST_BIND_PORT=8501

# --- Opcionais -------------------------------------------------------------
# Historico administrativo de e-mails (Brevo). Vazio desabilita o recurso.
BREVO_API_KEY=
DSPACE_NAME=Repositório PCIRN
DSPACE_SHORTNAME=PCIRN
