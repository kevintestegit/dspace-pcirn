#!/usr/bin/env bash
set -Eeuo pipefail
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
if ! command -v python3 >/dev/null 2>&1; then
    if (( EUID != 0 )) || [[ ! -t 0 ]] || (( $# != 0 )); then
        printf '%s\n' 'Python 3 ausente. Execute sudo dspacepcirn em um terminal para preparar o ambiente.' >&2
        exit 1
    fi
    # This is the local operating-system identity, never downloaded code.
    . /etc/os-release
    if [[ "${ID:-}" != ubuntu || "${VERSION_ID:-}" != 24.04 ]]; then
        printf '%s\n' 'Preparação automática exige Ubuntu 24.04.' >&2
        exit 1
    fi
    case "$(uname -m)" in
        x86_64|aarch64) ;;
        *) printf '%s\n' 'Arquitetura suportada: AMD64 ou ARM64.' >&2; exit 1 ;;
    esac
    printf '%s' 'Autoriza instalar ou atualizar dependências incompatíveis dos repositórios oficiais e iniciar/habilitar Docker quando necessário? [S/n]: '
    read -r answer
    case "${answer,,}" in
        ''|s|sim|y|yes) ;;
        *) printf '%s\n' 'Preparação cancelada.'; exit 1 ;;
    esac
    apt-get update
    apt-get -y --no-remove --no-upgrade install --no-install-recommends python3 ca-certificates
    python3 --version >/dev/null
    export DSPACEPCIRN_BOOTSTRAP_APPROVED=1
fi
exec python3 "${SCRIPT_DIR}/pcirn.py" "$@"
